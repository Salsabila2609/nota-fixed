# Supabase (database)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth
JWT_SECRET=your-random-secret-min-32-chars-ganti-ini

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OCR (Google Cloud Vision) - isi JSON service account yang di-base64
GOOGLE_CREDENTIALS_BASE64=

# Storage utama: Backblaze B2 (S3-compatible)
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_REGION=us-west-004
S3_ACCESS_KEY_ID=b2-key-id
S3_SECRET_ACCESS_KEY=b2-application-key
S3_BUCKET=nama-bucket-b2

# Storage lama: Cloudflare R2 (dipakai kalau S3_* di atas dikosongkan)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Antrean lokal saat storage tidak terjangkau (opsional)
LOCAL_STORAGE_DIR=/app/storage-buffer
LOCAL_SYNC_INTERVAL_MS=120000
